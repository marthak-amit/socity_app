{
  "expo": {
    "name": "SocietyPass",
    "slug": "societypass",
    "scheme": "societypass",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": { "image": "./assets/splash-icon.png", "resizeMode": "contain", "backgroundColor": "#4F46E5" },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.societypass.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "SocietyPass uses the camera to scan entry passes and invite QR codes.",
        "NSPhotoLibraryUsageDescription": "Choose payment screenshots and event photos to upload."
      }
    },
    "android": {
      "package": "app.societypass.mobile",
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#4F46E5" },
      "permissions": ["CAMERA", "POST_NOTIFICATIONS"]
    },
    "plugins": [
      "expo-router",
      ["expo-camera", { "cameraPermission": "SocietyPass uses the camera to scan entry passes and invite QR codes." }],
      ["expo-image-picker", { "photosPermission": "Choose payment screenshots and event photos to upload." }],
      "expo-secure-store",
      "expo-font",
      ["expo-notifications", { "color": "#4F46E5" }]
    ],
    "experiments": { "typedRoutes": false },
    "extra": { "eas": { "projectId": "" } }
  }
}
