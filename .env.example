# Copy to .env — docker compose reads this file. NEVER commit real secrets.

# ---- core ----
ENV=dev                         # dev | prod  (prod refuses to boot with dev secrets)
DATABASE_URL=postgresql+asyncpg://societypass:societypass@postgres:5432/societypass
POSTGRES_USER=societypass
POSTGRES_PASSWORD=societypass
POSTGRES_DB=societypass

# ---- secrets: generate with `openssl rand -hex 32` ----
JWT_SECRET=dev-jwt-secret-change-me-dev-jwt-secret
QR_SECRET=dev-qr-secret-change-me-dev-qr-secret
CORS_ORIGINS=*

# ---- OTP ----
OTP_PROVIDER=console            # console (logs the code) | msg91
OTP_FIXED_CODE=123456           # dev/demo only — ignored when ENV=prod
OTP_DEV_ECHO=true               # dev only: returns the code in the API response
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ---- storage: s3 (MinIO locally / Cloudflare R2 in prod) or local (filesystem, no MinIO needed) ----
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000                 # how the API container reaches storage
# URL that PHONES can reach. Use your machine's LAN IP when testing on a device (e.g. http://192.168.1.20:9000)
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000/societypass-public
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BUCKET=societypass-public
S3_PRIVATE_BUCKET=societypass-private
# For Cloudflare R2: S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto,
# S3_PUBLIC_BASE_URL=https://<your-public-bucket-domain>, S3_PUBLIC_ENDPOINT_URL=<same as endpoint>

# Public URL of the API (used by the local storage backend and deep links)
API_PUBLIC_URL=http://localhost:8000
APP_WEB_DOMAIN=https://societypass.app

# ---- platform ----
SUPER_ADMIN_PHONES=+919800000001   # comma separated; these numbers get super-admin on first login
PENDING_ORDER_TTL_HOURS=48

# ---- mobile (Expo) — see mobile/.env.example ----
# ---- admin-web (Vite) — see admin-web/.env.example ----
